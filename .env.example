# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取根目录的 .env 用于变量替换。

# ---------- 基础设施 ----------
TZ=Asia/Shanghai
WEB_PORT=80
POSTGRES_PORT=5432

POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me

# ---------- 应用 ----------
AUTO_MIGRATE=true
ANALYSIS_WORKERS=2

# OpenAI 兼容接入（embedding 也走这里）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 接入
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 向量化：维度需与数据库向量列一致，变更需重建 knowledge_vectors 表。
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
VECTOR_DIMENSION=1536

# 默认模型（用于摘要等辅助调用，以及首次启动的种子配置）
DEFAULT_MODEL=
DEFAULT_PROVIDER=openai

# 上传报告后自动入库的知识库 ID（为空则不订阅）
DEFAULT_KB_ID=

# 内置工具：web_search
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=

# 内置工具：只读 SQL（为空则禁用 sql_query）
SQL_DSN=
